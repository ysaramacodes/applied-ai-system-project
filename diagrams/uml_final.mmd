classDiagram
    %% Core Domain Classes
    class Owner {
        +String name
        +String contact_info
        +List availability
        +List pets
        +List tasks
        +add_pet(pet)
        +create_task(pet, task)
        +set_availability(availability)
        +generate_plan() Schedule
    }

    class Pet {
        +String name
        +String breed
        +int age
        +String sex
        +List health_conditions
        +List medications
        +String emergency_contact
        +List activities
        +String grooming
        +List tasks
        +add_task(task)
        +remove_task(task_id)
        +eat()
        +sleep()
        +walk()
        +take_medication()
        +play()
        +potty()
        +groom()
    }

    class Task {
        +String description
        +datetime time
        +int duration
        +String frequency
        +bool completion_status
        +Pet pet
        +String id
        +String preferred_time_slot
        +datetime scheduled_start
        +datetime scheduled_end
        +String assigned_to
        +List notes
        +schedule(start, end)
        +reschedule(new_start, new_end)
        +mark_complete(completed_time, notes)
        +_create_next_occurrence()
        +cancel(reason)
        +is_recurring() bool
        +is_conflicting(other) bool
    }

    %% Scheduling Core Classes
    class Scheduler {
        +Owner owner
        +List pets
        +List tasks
        +List availability
        +Schedule scheduled_plan
        +retrieve_tasks() List
        +filter_tasks(pet_name, include_completed) List
        +organize_tasks(pet_name, include_completed) List
        +sort_by_time(tasks) List
        +schedule(pet_name, include_completed) Schedule
        +_parse_preferred_start(task) datetime
        +_get_next_recurring_time(task) datetime
        +_has_conflict(start, end, plan, task) bool
        +_find_non_conflicting_slot(task, start, end, plan) tuple
        +manage_task(task)
        +explain_decision(slot) String
    }

    class Schedule {
        +date date
        +String day
        +List availability
        +List scheduled_slots
        +int total_duration
        +Owner owner
        +List unmet_tasks
        +List warnings
        +String status
        +add_scheduled_task_entry(task, start, end)
        +remove_scheduled_entry(index)
        +modify_slot(index, new_start, new_end)
        +get_slots() List
        +validate() bool
    }

    class ScheduledSlot {
        +Task task
        +datetime start_time
        +datetime end_time
        +String explanation
    }

    %% Persistence Layer
    class PersistenceLayer {
        +save_data(owner, filename) void
        +load_data(filename) Owner
        +get_or_create_owner(vault, owner_name, contact_info) Owner
        +get_or_create_pet(vault, pet_name, breed, age, sex) Pet
        +get_or_create_task(vault, task_description, duration, frequency) Task
    }

    %% Relationships
    Owner "1" --> "*" Pet : owns
    Owner "1" --> "*" Task : creates
    Owner "1" --> "1" Scheduler : uses
    
    Pet "1" --> "*" Task : has
    
    Scheduler "1" --> "1" Owner : manages
    Scheduler "1" --> "*" Pet : orchestrates
    Scheduler "1" --> "*" Task : filters/organizes
    Scheduler "1" --> "1" Schedule : creates
    
    Schedule "1" --> "*" ScheduledSlot : contains
    Schedule "1" --> "1" Owner : for
    Schedule "1" --> "*" Pet : considers
    Schedule "1" --> "*" Task : includes_unmet
    
    ScheduledSlot "1" --> "1" Task : holds
    
    PersistenceLayer "1" --> "1" Owner : saves/loads
    PersistenceLayer "1" --> "*" Pet : persists
    PersistenceLayer "1" --> "*" Task : persists
